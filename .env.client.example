# ==============================================================================
# JOHNSON SOFTWARES CRM — CLIENT VPS CONFIGURATION TEMPLATE
# ==============================================================================
# This file must be placed on the client VPS inside the deployment folder as `.env`.
# DO NOT share code or private build repositories with the client.
# The client only needs docker-compose.client-vps.yml and this .env file.
# ==============================================================================

# ── 1. Image Registry & Licensing ────────────────────────────────────────────
CRM_IMAGE_REGISTRY=ghcr.io/johnsonsoftwares
CRM_IMAGE_TAG=latest
APP_ENV=production
APP_NAME="CRM Enterprise SaaS"
FRONTEND_URL="https://crm.clientagency.com"
CORS_ORIGINS='["https://crm.clientagency.com"]'

# Heartbeat License Verification (Enforces valid subscription with your central server)
ENABLE_LICENSE_HEARTBEAT=true
LICENSE_KEY="LIC-AGENCY-XXXX-YYYY-ZZZZ"
LICENSE_VERIFY_URL="https://johnsonsoftwares.com/api/crm/license/verify"

# ── 2. Security & Encryption Keys ───────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY="generate_a_random_64_character_hex_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30
FIELD_ENCRYPTION_KEY="generate_a_random_32_byte_url_safe_base64_key"

# ── 3. Database & Redis Credentials ──────────────────────────────────────────
POSTGRES_DB=crm_production
POSTGRES_USER=crm_user
POSTGRES_PASSWORD="strong_random_db_password_here"
DATABASE_URL="postgresql+asyncpg://crm_user:strong_random_db_password_here@postgres:5432/crm_production"

REDIS_PASSWORD="strong_random_redis_password_here"
REDIS_URL="redis://:strong_random_redis_password_here@redis:6379/0"

# ── 4. Telecalling & Dialing Integrations (Indian Telecom Compliance) ────────
# Active Telephony Provider: "knowlarity" or "myoperator"
TELEPHONY_PROVIDER="myoperator"

# MyOperator Configuration (Click-to-Call, Live IVR, Recordings)
MYOP_COMPANY_ID="your_myoperator_company_id"
MYOP_SECRET_KEY="your_myoperator_secret_key"
MYOP_X_API_KEY="your_myoperator_x_api_key"
MYOP_PUBLIC_IVR_ID="your_myoperator_ivr_id"

# Knowlarity Configuration (Alternative Provider)
KNOWLARITY_API_KEY=""
KNOWLARITY_SRN=""

# ── 5. WhatsApp Business Cloud API (Meta Official) ───────────────────────────
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_waba_account_id"
WHATSAPP_ACCESS_TOKEN="EAAB..."
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_secret_string"

# ── 6. Indian DLT SMS Gateways (BhashSMS / BulkSmsPlans) ─────────────────────
SMS_GATEWAY_PROVIDER="bhashsms" # or "bulksmsplans"
SMS_API_KEY="your_sms_gateway_api_key"
SMS_SENDER_ID="JHNSON" # 6-character approved DLT Header
SMS_ENTITY_ID="1201159..." # Approved DLT Principal Entity ID
