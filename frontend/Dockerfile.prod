# ── Production frontend: build static assets, serve via nginx ───────────────
# Multi-stage: (1) vite build -> /app/dist, (2) nginx serves it + proxies /api.
# NOTE: we run `vite build` directly (NOT `npm run build`, which also runs tsc);
# the project has pre-existing unused-var type warnings that fail tsc but do not
# affect the actual bundle (esbuild transpiles fine, same as the dev server).

# ---- build stage ----
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npx vite build

# ---- serve stage ----
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
